# Local development. Copy to .env; production uses .env.production (see docs/07_HUONG_DAN_TRIEN_KHAI.md).
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
STORAGE_DRIVER=file
DATA_DIR=.data
# Set MONGO_URI and STORAGE_DRIVER=mongo to use MongoDB (pnpm infra:up starts one locally).
MONGO_URI=mongodb://127.0.0.1:27017/codecash?replicaSet=rs0
# Required in production; development generates an instance-local secret.
JWT_SECRET=
# Password for the sample accounts created on first start (default Passw0rd! in development).
SEED_PASSWORD=
# Optional internal engine worker: raw GET /decisions for the official Data Pack only.
# Live workflow and uploaded datasets still use the local Python adapter. See docs/29.
ENGINE_URL=
# One-click sign-in menu with the sample accounts (default on outside production).
DEMO_LOGIN=

# Detached signing adapter. local = explicit simulation; http never falls back to simulation.
SIGNING_PROVIDER=local
SIGNING_URL=
SIGNING_API_TOKEN=
SIGNING_KEY_FINGERPRINT=
# SIGNING_PROVIDER=remote signs through the remote signing service (apps/signer, `pnpm dev:signer`):
# the person confirms on a device (corner widget or /device on a phone). Shared with the service.
SIGNER_URL=http://127.0.0.1:3200
SIGNER_CLIENT_ID=codecash
SIGNER_CLIENT_SECRET=
SIGNER_WEBHOOK_SECRET=
# Optional pin of the service's CA key (sha256 of its public key); otherwise the first key is kept.
SIGNER_CA_FINGERPRINT=
# The service side (apps/signer): keys for device sessions, the demo PIN, its own data folder.
SIGNER_DEVICE_SECRET=
SIGNER_DEFAULT_PIN=123456

# Real document extraction. Gemini runs only on the API; keep credentials out of VITE_*.
EXTRACTION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
