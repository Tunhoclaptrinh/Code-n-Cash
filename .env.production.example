# Copy to .env.production on the server and fill in. Never commit the real file.

# Required. Generate with: openssl rand -hex 48
JWT_SECRET=

# Public origin(s) of the web app, comma-separated (used for CORS).
WEB_ORIGIN=https://codecash.example.com

# Set only for the first start to create the five sample accounts, then remove it
# and change every password from Administration > Users.
SEED_PASSWORD=

# Leave empty to use the bundled MongoDB container. For a managed cluster (e.g. Atlas):
# MONGO_URI=mongodb+srv://user:password@cluster.example.net/codecash?retryWrites=true
MONGO_URI=

# Optional long-running engine worker instead of spawning the Python CLI per request.
ENGINE_URL=

# Where nginx listens on the host. Keep 127.0.0.1 behind a TLS reverse proxy (Caddy/nginx);
# use 0.0.0.0 only for a quick test without TLS.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Image naming when pushing to a registry, e.g. ghcr.io/<owner>/codecash
IMAGE_PREFIX=codecash
IMAGE_TAG=latest

# One-click sign-in menu with the sample accounts. Only for demo deployments without real data.
DEMO_LOGIN=false

# Explicit simulated signing, or http for a pinned detached-signature bridge.
SIGNING_PROVIDER=local
SIGNING_URL=
SIGNING_API_TOKEN=
SIGNING_KEY_FINGERPRINT=

# Server-side contract extraction. Set gemini and supply the secret to enable AI.
EXTRACTION_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
