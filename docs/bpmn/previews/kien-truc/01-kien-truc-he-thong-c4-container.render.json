  "labels": [
    {
      "id": "B",
      "text": "<b style=\"font-size:18px\">CodeCash</b>",
      "x": 342,
      "y": 895,
      "width": 89,
      "height": 22
    },
    {
      "id": "U",
      "text": "<b style=\"font-size:22px\">Người dùng</b><br><br><span style=\"font-size:16px\">Bên mua (chủ hợp đồng, cán bộ hợp đồng, người phê duyệt), nhà cung cấp, kiểm soát viên, quản trị hệ thống, kiểm toán</span>",
      "x": 31,
      "y": 205,
      "width": 228,
      "height": 118
    },
    {
      "id": "DP",
      "text": "<b style=\"font-size:22px\">Data Pack BTC</b><br><br><span style=\"font-size:16px\">Tệp CSV: 100 hợp đồng, 405 mốc, 1.134 sự kiện, 128 luật</span>",
      "x": 43,
      "y": 681,
      "width": 204,
      "height": 98
    },
    {
      "id": "W",
      "text": "<b style=\"font-size:22px\">Ứng dụng web</b><br><br><span style=\"font-size:16px\">Màn hình theo vai trò; chỉ hiển thị và gửi thao tác, không ra quyết định</span>",
      "x": 393,
      "y": 105.5,
      "width": 304,
      "height": 79
    },
    {
      "id": "A",
      "text": "<b style=\"font-size:22px\">Máy chủ nghiệp vụ (API)</b><br><br><span style=\"font-size:16px\">Xác thực, phân quyền theo tổ chức; thao tác nghiệp vụ có kiểm quyền; ký theo trình tự; đọc PDF/DOCX; nhật ký chuỗi băm, neo đầu chuỗi</span>",
      "x": 393,
      "y": 391,
      "width": 334,
      "height": 98
    },
    {
      "id": "E",
      "text": "<b style=\"font-size:22px\">Bộ máy quyết định (engine)</b><br><br><span style=\"font-size:16px\">Lọc bằng chứng; kiểm phê duyệt, tranh chấp, thời hạn; chọn luật đầu tiên khớp; tính tiền bằng Decimal</span>",
      "x": 973,
      "y": 376,
      "width": 304,
      "height": 98
    },
    {
      "id": "D",
      "text": "<b style=\"font-size:22px\">Cơ sở dữ liệu</b><br><br><span style=\"font-size:16px\">Hợp đồng, sự kiện, quyết định, phiên bản luật, nhật ký audit</span>",
      "x": 393,
      "y": 713,
      "width": 304,
      "height": 79
    },
    {
      "id": "F",
      "text": "<b style=\"font-size:22px\">Kho tệp</b><br><br><span style=\"font-size:16px\">Tệp hợp đồng, khoá ký cục bộ, biên nhận neo audit</span>",
      "x": 973,
      "y": 713,
      "width": 304,
      "height": 79
    },
    {
      "id": "G",
      "text": "<b style=\"font-size:22px\">Dịch vụ AI</b><br><br><span style=\"font-size:16px\">Tuỳ chọn. Đọc hợp đồng, gợi ý điều khoản kèm trang nguồn; người dùng xác nhận</span>",
      "x": 1453,
      "y": 105.5,
      "width": 304,
      "height": 79
    },
    {
      "id": "S",
      "text": "<b style=\"font-size:22px\">Dịch vụ ký số</b><br><br><span style=\"font-size:16px\">Tuỳ chọn. Ký mã băm tài liệu; bản demo ký cục bộ trong máy chủ</span>",
      "x": 1453,
      "y": 375.5,
      "width": 304,
      "height": 79
    },
    {
      "id": "K",
      "text": "<b style=\"font-size:22px\">Kế toán</b><br><br><span style=\"font-size:16px\">Chưa tích hợp. Nhận lệnh chi; bản demo ghi nhận chuyển chi trong CodeCash</span>",
      "x": 1453,
      "y": 635.5,
      "width": 304,
      "height": 79
    },
    {
      "id": "LG",
      "text": "<b>Chú giải:</b> hình người = người dùng · xanh = container của CodeCash · trụ = nơi lưu dữ liệu · xám = hệ thống ngoài · viền hoặc mũi tên nét đứt = chưa tích hợp · mũi tên đi từ bên gọi tới bên được gọi",
      "x": 1382,
      "y": 829,
      "width": 408,
      "height": 72
    },
    {
      "id": "r1",
      "text": "Dùng màn hình<br>theo vai trò",
      "x": 268.5,
      "y": 93,
      "width": 103,
      "height": 36
    },
    {
      "id": "r2",
      "text": "Gửi thao tác, đọc dữ liệu",
