{
  "name": "codecash",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @codecash/web dev",
    "dev:api": "pnpm --filter @codecash/api dev",
    "dev:engine": "python3 apps/engine/server.py",
    "build": "pnpm --filter @codecash/api build && pnpm --filter @codecash/web build",
    "start:api": "node apps/api/dist/main.js",
    "preview:web": "pnpm --filter @codecash/web preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint --max-warnings 0 apps/web/src apps/api/src packages/ui/src packages/api-client/src packages/contracts/src",
    "format": "prettier --write apps packages scripts",
    "format:check": "prettier --check apps packages scripts",
    "test": "pnpm test:python && pnpm test:unit",
    "test:python": "python3 -m unittest discover -s tests -v",
    "test:unit": "pnpm --filter @codecash/api build && node tests/foundation/resource.test.mjs && node tests/foundation/workflow.test.mjs && node tests/foundation/trust.test.mjs && node tests/foundation/domain-types.test.mjs && node tests/foundation/listing.test.mjs && node tests/foundation/i18n.test.mjs",
    "test:workflow": "pnpm --filter @codecash/api build && node tests/foundation/workflow.test.mjs",
    "test:e2e": "node scripts/smoke.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "guide:screenshots": "node scripts/guide-screenshots.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test",
    "check:data": "python3 tools/kiem_chung_nghiep_vu.py --check",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "docker:build": "docker compose -f infra/compose.prod.yaml build",
    "docker:up": "docker compose -f infra/compose.prod.yaml --env-file .env.production up -d",
    "docker:down": "docker compose -f infra/compose.prod.yaml --env-file .env.production down"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
